# Maintainer: kf6_darwin Maintainers <maintainers@kf6-darwin.local>
# Upstream: https://invent.kde.org/frameworks/kservice

pkgname=kservice
pkgver=6.31.0
pkgrel=1
pkgdesc='Advanced plugin and service introspection'
arch=('darwin_x86_64' 'darwin_arm64')
url='https://community.kde.org/Frameworks'
license=('LGPL-2.0-only' 'LGPL-3.0-only')
groups=('kf6')
depends=('qt6-base' 'kconfig' 'kcoreaddons' 'ki18n')
makedepends=('extra-cmake-modules')
_commit='3dd29f7847e88d3f45d833ce1a772738e73915e9'
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/${pkgname}-${pkgver}.tar.xz")
sha256sums=('a3e6964ca12aae984f3600fb439c1a906ffe8fecc2111fbfa3fb00052d566e23')
sha512sums=('68eb81bfdd3aad72257fc6455eae171fa54f04adea9b039a743c720bf6d8341da56286c964762777556cddb5fa2503b6a822f0210bc9517d9378b2f9e6680f25')

build() {
    export LC_ALL=en_US.UTF-8
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/local/bin:/usr/local/bin"

    local target_arch="${CARCH#darwin_}"
    [[ -z "${target_arch}" || "${target_arch}" == "${CARCH}" ]] && target_arch="$(uname -m)"

    cmake -B build -S "${pkgname}-${pkgver}" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="/opt/pacman" \
        -DKDE_INSTALL_BUNDLEDIR="/opt/pacman/Applications/KDE" \
        -DAPPLE_SUPPRESS_X11_WARNING=ON \
        -DPython3_EXECUTABLE="/usr/bin/python3" \
        -DCMAKE_IGNORE_PREFIX_PATH="/opt/local;/usr/local;/opt/homebrew" \
        -DCMAKE_PREFIX_PATH="/opt/pacman" \
        -DCMAKE_OSX_ARCHITECTURES="${target_arch}" \
        -DCMAKE_OSX_DEPLOYMENT_TARGET="15.0" \
        -DCMAKE_INSTALL_RPATH="/opt/pacman/lib" \
        -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
        -DBUILD_TESTING=OFF

    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build

    install -dm755 "${pkgdir}/opt/pacman/share/licenses/${pkgname}"
    cp -a "${pkgname}-${pkgver}/LICENSES/"* "${pkgdir}/opt/pacman/share/licenses/${pkgname}/"

    find "${pkgdir}/opt/pacman" -type f -print0 | while IFS= read -r -d '' f; do
        if file -b "$f" | grep -qE "Mach-O.*(executable|dynamically linked shared library|bundle)"; then
            codesign --sign - --force "$f" 2>/dev/null || true
        fi
    done
}


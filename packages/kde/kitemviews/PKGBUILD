# Maintainer: Revanth Reddy Nemtoor <revanthreddyn123@gmail.com>
pkgname=kitemviews
pkgver=6.31.0
pkgrel=1
pkgdesc="Widget addons for Qt Model/View (KDE Frameworks 6 for Darwin)"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://invent.kde.org/frameworks/kitemviews"
license=('LGPL-2.0-or-later' 'LGPL-2.1-or-later')
depends=('qt6-base')
makedepends=('extra-cmake-modules' 'qt6-tools' 'cmake' 'ninja')
options=('!strip')
_commit="1999b84038c9aae77dce9709ca6c52e186ef4912" # refs/tags/v6.31.0^{}
source=("https://download.kde.org/stable/frameworks/${pkgver%.*}/${pkgname}-${pkgver}.tar.xz")
sha256sums=('cf0d9bf175619ed76cda99a20b04d349082a7c0e4bd1b2ce1dcf2631131cabcd')
sha512sums=('0a6096c7a73f3bd6fb1adbb6971e9f1df29c3c34d39385158a69487447c454d9d23473fbbd257a5878b60392413ab0af3c77cb3d73c7d77f5ed14574d3787a8a')

build() {
  local _arch
  case "${CARCH:-$(uname -m)}" in
    x86_64|darwin_x86_64) _arch="x86_64" ;;
    arm64|darwin_arm64)   _arch="arm64" ;;
    *)                    _arch="$(uname -m)" ;;
  esac

  export LC_ALL=en_US.UTF-8
  export PKG_CONFIG_LIBDIR="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
  export PKG_CONFIG_PATH="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
  export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/local/bin:/usr/local/bin"

  cmake -B build -S "${pkgname}-${pkgver}" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/pacman \
    -DKDE_INSTALL_BUNDLEDIR=/opt/pacman/Applications/KDE \
    -DAPPLE_SUPPRESS_X11_WARNING=ON \
    -DPython3_EXECUTABLE=/usr/bin/python3 \
    -DCMAKE_OSX_ARCHITECTURES="${_arch}" \
    -DCMAKE_OSX_DEPLOYMENT_TARGET=15.0 \
    -DCMAKE_PREFIX_PATH=/opt/pacman \
    -DCMAKE_IGNORE_PREFIX_PATH="/opt/local;/usr/local;/opt/homebrew" \
    -DCMAKE_INSTALL_RPATH="/opt/pacman/lib" \
    -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
    -DBUILD_TESTING=OFF

  cmake --build build --parallel
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  if [[ -d "${pkgname}-${pkgver}/LICENSES" ]]; then
    install -d "${pkgdir}/opt/pacman/share/licenses/${pkgname}"
    cp -a "${pkgname}-${pkgver}/LICENSES/"* "${pkgdir}/opt/pacman/share/licenses/${pkgname}/"
  fi

  find "${pkgdir}" -name ".DS_Store" -delete 2>/dev/null || true
}


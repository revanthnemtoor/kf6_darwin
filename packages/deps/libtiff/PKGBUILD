# Maintainer: kf6_darwin Maintainers <maintainers@kf6-darwin.local>
# Upstream: https://gitlab.com/libtiff/libtiff

pkgname=libtiff
pkgver=4.7.2
pkgrel=1
pkgdesc='Library for manipulation of TIFF images'
arch=('darwin_x86_64' 'darwin_arm64')
url='http://www.simplesystems.org/libtiff/'
license=('libtiff')
depends=('zlib' 'zstd' 'xz' 'libjpeg-turbo')
makedepends=()
_commit='d01a94be176f5f6a87f7ee1c0b32e65416aa2b4d'
source=("https://download.osgeo.org/libtiff/tiff-${pkgver}.tar.xz")
sha256sums=('4996f0c4f93094719b1ca5c6279b20e588773ba8a247533e486416fb662ddb88')
sha512sums=('884dbd26f9eebcff4676696757ac315836c460696d403609a3f804368be3571f5f0e99a96dd7cc9fedc5dc2adfc087175d5d6823dca9eba10c733aa1676d78de')

build() {
    export LC_ALL=en_US.UTF-8
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/local/bin:/usr/local/bin"

    local target_arch="${CARCH#darwin_}"
    [[ -z "${target_arch}" || "${target_arch}" == "${CARCH}" ]] && target_arch="$(uname -m)"

    cmake -B build -S "tiff-${pkgver}" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="/opt/pacman" \
        -DCMAKE_INSTALL_NAME_DIR="/opt/pacman/lib" \
        -DCMAKE_IGNORE_PREFIX_PATH="/opt/local;/usr/local;/opt/homebrew" \
        -DCMAKE_PREFIX_PATH="/opt/pacman" \
        -DCMAKE_OSX_ARCHITECTURES="${target_arch}" \
        -DCMAKE_OSX_DEPLOYMENT_TARGET="15.0" \
        -DCMAKE_INSTALL_RPATH="/opt/pacman/lib" \
        -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
        -DBUILD_SHARED_LIBS=ON \
        -Dtiff-static=OFF \
        -Dtiff-framework=OFF \
        -Dtiff-tests=OFF \
        -Dtiff-docs=OFF \
        -Dtiff-contrib=OFF

    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build

    install -dm755 "${pkgdir}/opt/pacman/share/licenses/${pkgname}"
    cp -a "tiff-${pkgver}/LICENSE.md" "${pkgdir}/opt/pacman/share/licenses/${pkgname}/"

    find "${pkgdir}/opt/pacman" -type f -print0 | while IFS= read -r -d '' f; do
        if file -b "$f" | grep -qE "Mach-O.*(executable|dynamically linked shared library|bundle)"; then
            codesign --sign - --force "$f" 2>/dev/null || true
        fi
    done
}

